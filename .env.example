# Public website
# Optional. Production builds default to https://domigen-backend.onrender.com.
# Set this only when deploying the backend somewhere else.
VITE_API_URL=https://your-api.example.com

# Same-browser branding bridge to the admin panel (optional).
VITE_ADMIN_URL=https://your-admin-site.example.com

# Stripe does not need a VITE_ key here. The publishable key is fetched from
# GET /api/payments/config so the same build works in test and live mode.
